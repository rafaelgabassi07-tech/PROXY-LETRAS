{
  "name": "gospel-lyrics-proxy",
  "private": true,
  "version": "2.6.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch local-server.ts",
    "start": "tsx local-server.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc -p tsconfig.server.json",
    "test:proxy": "tsx server/proxySelfTest.ts",
    "test:deploy": "node scripts/verify-vercel-config.mjs",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "lru-cache": "^11.5.2",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": "24.x"
  }
}
