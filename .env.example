# Produção oficial
PUBLIC_PROXY_URL=https://proxy-letras.vercel.app
# CORS afeta navegadores/painel; o app Android nativo não depende de Origin.
ALLOWED_ORIGINS=https://proxy-letras.vercel.app

# Gospel Lyrics Proxy v2
PORT=3000


# Chave oficial do Vagalume. Recomendada: a API atual usa autenticação por apiKey.
# Sem chave, o Proxy mantém fallback pela página web do próprio Vagalume e pelo Letras.
VAGALUME_API_KEY=

# Orçamentos totais do fluxo adaptativo Letras + Vagalume.
# Busca: 3200..9000 ms (padrão 7600). Letra: 5000..12000 ms (padrão 8500).
LYRICS_SEARCH_BUDGET_MS=7600
LYRICS_GET_BUDGET_MS=8500
