# Produção oficial
PUBLIC_PROXY_URL=https://proxy-letras.vercel.app
# CORS afeta navegadores/painel; o app Android nativo não depende de Origin.
ALLOWED_ORIGINS=https://proxy-letras.vercel.app

# Gospel Lyrics Proxy v2
PORT=3000


# Optional official providers. The scraper for Letras.mus.br works without a token.
VAGALUME_API_KEY=
GENIUS_ACCESS_TOKEN=
# Optional custom provider.
CUSTOM_GOSPEL_API_URL=
CUSTOM_GOSPEL_API_AUTH=
